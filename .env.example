# =============================================================================
# Registrar System - Environment Variables
# Copy to .env and update values for your environment
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-a-secure-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS (frontend origins allowed to call the API) ---
# Local dev: http://localhost:5173 | Docker: http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- MySQL Database ---
# Local (no Docker): MYSQL_HOST=localhost, MYSQL_USER=root, MYSQL_PASSWORD=
# Docker: MYSQL_HOST=db, MYSQL_USER=enroll_user, MYSQL_PASSWORD=enroll_password
MYSQL_DATABASE=enrollment_system
MYSQL_USER=enroll_user
MYSQL_PASSWORD=enroll_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# Optional: shared Django cache (staff-chat WebSocket counts across workers). Example: redis://localhost:6379/2
# CACHE_REDIS_URL=

# --- JWT (browser sessions; refresh keeps you logged in without retyping password) ---
# Local use: long access + long refresh = rarely see login. Tighten for stricter control.
# Use either minutes OR days for access (minutes wins if set):
#   JWT_ACCESS_MINUTES=30
# Or days (default 7 if neither is set):
#   JWT_ACCESS_DAYS=7
JWT_ACCESS_DAYS=7
# How long a refresh token works to obtain new access tokens (default 30)
JWT_REFRESH_DAYS=30

# --- Frontend (optional: API base URL for Vite build) ---
VITE_API_BASE_URL=http://localhost:8000/api
